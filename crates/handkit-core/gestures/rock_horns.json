{
  "name": "rock_horns",
  "description": "Rock horns: index and pinky raised, middle and ring curled down under the thumb; back of the hand to the viewer.",
  "version": 1,
  "hands": {
    "right": {
      "place": { "wrist": [0, 0, 0], "palm_facing": [0, 0, -1], "fingers_toward": [0, 1, 0] },
      "thumb": { "cmc_flex": 16.2, "cmc_abd": 24.0, "cmc_rot": 48.7, "mcp_flex": 20.9, "ip_flex": 13.7 },
      "index": { "mcp_abd": 2, "mcp_flex": 6, "pip_flex": 8, "dip_flex": 5 },
      "middle": { "mcp_abd": 0, "mcp_flex": 75, "pip_flex": 95, "dip_flex": 50 },
      "ring": { "mcp_abd": 0, "mcp_flex": 78, "pip_flex": 95, "dip_flex": 50 },
      "pinky": { "mcp_abd": 12, "mcp_flex": 8, "pip_flex": 10, "dip_flex": 6 },
      "palm_cup": 6
    }
  },
  "goals": [{ "touch": ["right.thumb.pad", "right.middle.middle"], "vary": ["right.thumb.*"] }],
  "camera": { "position": [0.08, 0.14, 0.4], "target": [0.0, 0.085, 0.0], "fov": 35 }
}
