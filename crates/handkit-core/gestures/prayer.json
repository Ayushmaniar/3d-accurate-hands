{
  "name": "prayer",
  "description": "Prayer hands: palms and fingers pressed flat together, fingers pointing up, thumbs toward the chest; seen from the front and slightly to the side.",
  "version": 1,
  "hands": {
    "right": {
      "place": { "wrist": [-0.0277, 0, 0], "palm_facing": [1.157, -0.189, -0.098], "fingers_toward": [0.159, 0.954, 0.092] },
      "twist": 0,
      "wrist_flex": -55,
      "wrist_dev": 30,
      "thumb": { "cmc_flex": 6, "cmc_abd": -10, "cmc_rot": -5, "mcp_flex": -2.5, "ip_flex": -4.2 },
      "index": { "mcp_abd": -3, "mcp_flex": -12.6, "pip_flex": 11.7 },
      "middle": { "mcp_abd": 0, "mcp_flex": -13.8, "pip_flex": 11.1 },
      "ring": { "mcp_abd": 2, "mcp_flex": -14.2, "pip_flex": 10.9 },
      "pinky": { "mcp_abd": 3, "mcp_flex": -13.2, "pip_flex": 11.4 }
    },
    "left": { "mirror": "right" }
  },
  "goals": [
    { "touch": ["right.middle.metacarpal", "left.middle.metacarpal"], "vary": ["right.place"] },
    { "touch": ["right.thumb.proximal", "left.thumb.proximal"], "vary": ["right.thumb.ip_flex", "right.thumb.mcp_flex"] },
    { "touch": ["right.index.distal", "left.index.distal"], "vary": ["right.index.mcp_flex", "right.index.pip_flex"] },
    { "touch": ["right.middle.distal", "left.middle.distal"], "vary": ["right.middle.mcp_flex", "right.middle.pip_flex"] },
    { "touch": ["right.ring.distal", "left.ring.distal"], "vary": ["right.ring.mcp_flex", "right.ring.pip_flex"] },
    { "touch": ["right.pinky.distal", "left.pinky.distal"], "vary": ["right.pinky.mcp_flex", "right.pinky.pip_flex"] }
  ],
  "camera": { "position": [0.25, 0.15, 0.35], "target": [0, 0.09, 0], "fov": 35 }
}
