      "index": { "mcp_abd": 2.7, "mcp_flex": 12.5, "pip_flex": 53.6, "dip_flex": 35.7 },
      "middle": { "mcp_abd": 0, "mcp_flex": 70, "pip_flex": 90, "dip_flex": 48 },
      "ring": { "mcp_abd": 0, "mcp_flex": 76, "pip_flex": 92, "dip_flex": 50 },
      "pinky": { "mcp_abd": 0, "mcp_flex": 82, "pip_flex": 94, "dip_flex": 50 },
      "palm_cup": 8,
