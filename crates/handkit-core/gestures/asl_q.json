{
  "name": "asl_q",
  "description": "ASL Q: the G hand pointing down: index and thumb parallel, pointing at the floor, other fingers curled; the thumb side toward the viewer so both show, the forearm coming in level from the signer's right.",
  "version": 1,
  "hands": {
    "right": {
      "place": {
        "wrist": [0, 0, 0],
        "palm_facing": [1, 0, 0.3],
        "fingers_toward": [0.1, -1, 0.2],
        "forearm_toward": [-0.85, 0.25, -0.45]
      },
      "palm_cup": 8,
      "thumb": { "cmc_flex": 16.3, "cmc_abd": 2.3, "cmc_rot": 44.3, "mcp_flex": 11.8, "ip_flex": 5.0 },
      "index": { "mcp_abd": 0, "mcp_flex": 2, "pip_flex": 6 },
      "middle": { "mcp_abd": 0, "mcp_flex": 88, "pip_flex": 98 },
      "ring": { "mcp_abd": -3, "mcp_flex": 88, "pip_flex": 98 },
      "pinky": { "mcp_abd": 0, "mcp_flex": 85, "pip_flex": 88 }
    }
  },
  "goals": [{ "touch": ["right.thumb.pad", "right.index.proximal"], "gap_mm": 14, "vary": ["right.thumb.*"] }],
  "camera": { "position": [0.04, -0.01, 0.45], "target": [0.03, -0.08, 0.03], "fov": 34 }
}
