{
  "name": "four",
  "description": "Four: index, middle, ring and pinky raised and slightly apart, the thumb folded across the palm; palm to the viewer.",
  "version": 1,
  "hands": {
    "right": {
      "place": { "fingers_toward": [0, 1, 0], "palm_facing": [0, 0, 1], "wrist": [0, 0, 0] },
      "palm_cup": 8,
      "thumb": { "cmc_abd": 2.7, "cmc_flex": 36.5, "cmc_rot": 32.5, "ip_flex": 10.0, "mcp_flex": 53.0 },
      "index": { "mcp_abd": 5, "mcp_flex": 4, "pip_flex": 6 },
      "middle": { "mcp_abd": 0, "mcp_flex": 4, "pip_flex": 7 },
      "ring": { "mcp_abd": 3, "mcp_flex": 6, "pip_flex": 9 },
      "pinky": { "mcp_abd": 5, "mcp_flex": 8, "pip_flex": 11 }
    }
  },
  "goals": [{ "touch": ["right.thumb.distal", "right.ring.metacarpal"], "vary": ["right.thumb.*"] }, { "touch": ["right.index.distal", "right.middle.distal"], "gap_mm": 16.1 }, { "touch": ["right.ring.distal", "right.pinky.distal"], "gap_mm": 15.3 }],
  "camera": { "position": [0.08, 0.13, 0.4], "target": [0.0, 0.1, 0.01], "fov": 36 }
}
