      "thumb": { "cmc_flex": 25.1, "cmc_abd": 33.1, "cmc_rot": 49.1, "mcp_flex": 53.0, "ip_flex": -4.7 },
      "index": { "mcp_abd": 1.9, "mcp_flex": 5.4, "pip_flex": 6.8, "mcp_roll": -1.2, "dip_flex": 4.5 },
      "middle": { "mcp_abd": 0, "mcp_flex": 4, "pip_flex": 7 },
      "ring": { "mcp_abd": 1.6, "mcp_flex": 6.1, "pip_flex": 9.1, "mcp_roll": 1.5, "dip_flex": 6.1 },
      "pinky": { "mcp_abd": 0, "mcp_flex": 80, "pip_flex": 85 }
