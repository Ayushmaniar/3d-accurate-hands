{
  "name": "asl_v",
  "description": "ASL V: index and middle straight up in a wide V, the thumb holding ring and pinky down; palm to the viewer.",
  "version": 1,
  "hands": {
    "right": {
      "place": { "wrist": [0, 0, 0], "palm_facing": [0, 0, 1], "fingers_toward": [0, 1, 0] },
      "palm_cup": 10,
      "thumb": { "cmc_flex": 15.8, "cmc_abd": 42.7, "cmc_rot": 48.8, "mcp_flex": 47.2, "ip_flex": 26.1 },
      "index": { "mcp_abd": 5.2, "mcp_flex": 3.2, "pip_flex": 5.1, "mcp_roll": -0.8, "dip_flex": 3.4 },
      "middle": { "mcp_abd": -5.0, "mcp_flex": 3.2, "pip_flex": 5.2, "mcp_roll": 0.9, "dip_flex": 3.5 },
      "ring": { "mcp_abd": -3, "mcp_flex": 88, "pip_flex": 98 },
      "pinky": { "mcp_abd": 0, "mcp_flex": 85, "pip_flex": 88 }
    }
  },
  "goals": [
    { "touch": ["right.thumb.distal", "right.ring.middle"], "vary": ["right.thumb.*"] },
    { "touch": ["right.index.tip", "right.middle.tip"], "gap_mm": 45 }
  ],
  "camera": { "position": [0.0, 0.11, 0.42], "target": [0.0, 0.085, 0.02], "fov": 34 }
}
