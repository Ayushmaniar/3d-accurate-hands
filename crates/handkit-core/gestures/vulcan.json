{
  "name": "vulcan",
  "description": "Vulcan salute: palm to the viewer, index and middle held together, ring and pinky held together, a V gap between middle and ring, thumb stretched out to the side.",
  "version": 1,
  "hands": {
    "right": {
      "place": { "wrist": [0, 0, 0], "palm_facing": [0, 0, 1], "fingers_toward": [0, 1, 0] },
      "thumb": { "cmc_flex": -15, "cmc_abd": 15, "cmc_rot": 10, "mcp_flex": 5, "ip_flex": 5 },
      "index": { "mcp_abd": -1.3, "mcp_flex": 5, "pip_flex": 6, "dip_flex": 4 },
      "middle": { "mcp_abd": 5.5, "mcp_flex": 5, "pip_flex": 6, "dip_flex": 4 },
      "ring": { "mcp_abd": 8.7, "mcp_flex": 5, "pip_flex": 8, "dip_flex": 5 },
      "pinky": { "mcp_abd": -1.7, "mcp_flex": 7, "pip_flex": 10, "dip_flex": 6 }
    }
  },
  "goals": [
    {
      "touch": ["right.index.side_ulnar", "right.middle.middle"],
      "vary": ["right.index.mcp_abd", "right.middle.mcp_abd", "right.ring.mcp_abd", "right.pinky.mcp_abd"]
    },
    {
      "touch": ["right.pinky.side_radial", "right.ring.middle"],
      "gap_mm": 2,
      "vary": ["right.index.mcp_abd", "right.middle.mcp_abd", "right.ring.mcp_abd", "right.pinky.mcp_abd"]
    },
    {
      "touch": ["right.middle.distal", "right.ring.distal"],
      "gap_mm": 28,
      "vary": ["right.index.mcp_abd", "right.middle.mcp_abd", "right.ring.mcp_abd", "right.pinky.mcp_abd"]
    }
  ],
  "camera": { "position": [0.05, 0.11, 0.42], "target": [0.0, 0.09, 0.0], "fov": 36 }
}
