      "thumb": { "cmc_flex": 3.4, "cmc_abd": 17.4, "cmc_rot": 49.1, "mcp_flex": 53.0, "ip_flex": 69.3 },
      "index": { "mcp_abd": -11.0, "mcp_flex": 2, "pip_flex": 4 },
      "middle": { "mcp_abd": -5.3, "mcp_flex": 2, "pip_flex": 4 },
