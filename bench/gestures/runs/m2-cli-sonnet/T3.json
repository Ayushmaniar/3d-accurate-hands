      "thumb": { "cmc_flex": -30.0, "cmc_abd": 12.6, "cmc_rot": 37.6, "mcp_flex": -3.3, "ip_flex": 35.0 },
      "index": { "mcp_flex": 35.0, "pip_flex": 39.6, "mcp_abd": 18.7, "mcp_roll": 0.9, "dip_flex": 60.4 },
      "middle": { "mcp_flex": 29.9, "pip_flex": 55.6, "mcp_abd": 8.9, "mcp_roll": 7.7 },
      "ring": { "mcp_flex": 40, "pip_flex": 55 },
